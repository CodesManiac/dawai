# ─────────────────────────────────────────────────────────────
# Dawai — environment template
# Copy to .env.local and fill in locally. Never commit real values.
# ─────────────────────────────────────────────────────────────

# Public application URL. Used for metadata and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Planned integrations (not read by the app yet) ───────────
# Task 001 only documents these variables. They are intentionally
# inactive until the corresponding feature is approved and built.

# Supabase — public browser-safe values (Task 002+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider gateway key — server-only (AI integration task)
AI_GATEWAY_API_KEY=
